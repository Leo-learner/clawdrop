PORT=3010
HOST=0.0.0.0
UPLOAD_TOKEN=change-me-upload-token
ADMIN_TOKEN=change-me-admin-token
# Optional: sign the browser admin in with the dkz12345 Clerk account instead
# (all three together; ADMIN_TOKEN is then ignored).
# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_JWT_KEY_FILE=deploy/clerk-dkz12345.pem
# OWNER_CLERK_USER_ID=user_...
MAX_FILE_SIZE_MB=200
MAX_STORAGE_MB=10240
CLAWDROP_RATE_LIMIT_KB=100
STORAGE_DIR=storage
DATABASE_PATH=data/clawdrop.sqlite
PUBLIC_BASE_URL=http://localhost:3010
AUTO_CLEANUP_ENABLED=false
AUTO_CLEANUP_DAYS=30
AUTO_CLEANUP_INTERVAL_HOURS=12
